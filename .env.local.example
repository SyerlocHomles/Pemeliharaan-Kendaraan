# Salin file ini jadi ".env.local" untuk development di komputer sendiri.
# Untuk di Vercel: isi nilai yang sama di Project Settings → Environment Variables.

# --- Supabase ---
# Ambil dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-public-key

# HANYA untuk app/api/cron/reminders/route.ts — JANGAN pernah dipakai di
# kode yang jalan di browser (tanpa awalan NEXT_PUBLIC_ supaya tidak
# ke-bundle ke sisi client). Ambil dari: Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-key

# --- Reminder Email (Resend) ---
# Daftar gratis di https://resend.com, ambil API key di dashboard-nya.
RESEND_API_KEY=isi-dengan-resend-api-key
REMINDER_EMAIL_TO=email-kamu@gmail.com
REMINDER_EMAIL_FROM=Pemeliharaan Kendaraan <onboarding@resend.dev>

# --- Keamanan endpoint cron ---
# Isi bebas, string acak apa saja (jangan dibagikan ke siapa pun).
# Dipakai untuk memastikan cuma Vercel Cron yang boleh memicu endpoint ini.
CRON_SECRET=ganti-dengan-string-acak-panjang
